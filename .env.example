# Copy to .env (never commit .env). Only the keys for the providers you use are needed.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
OLLAMA_URL=http://localhost:11434

# Intent classifier deployed in the app: embedding (default) or rule
INTENT_CLASSIFIER=embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INTENT_MIN_SCORE=0.45
INTENT_MARGIN=0.04
